(declare-codatatypes ((BoolList 0)) (((empty) (cons (first Bool) (rest BoolList)))))
(declare-codatatypes ((BoolListPair 0)) (((bool-list-pair (bl0 BoolList) (bl1 BoolList)))))
(declare-const a BoolList)
(define-const b BoolList (cons true a))
(check-sat-assuming ((= b empty)))
(check-sat-assuming ((= b (cons false a))))
(check-sat-assuming ((= b (cons true b))))
(check-sat-assuming ((= b (cons true b)) (= a empty)))
(check-sat-assuming ((= b (cons true b)) (not (= a (cons (first a) (rest a))))))
