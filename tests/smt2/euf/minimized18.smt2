(declare-sort U)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun c () U)
(declare-fun d () U)
(declare-fun f (U) U)
(declare-fun g (U U) U)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun r () Bool)
(assert (= (f a) (g (f c) d)))
(assert (= q (not (= a b))))
(assert (= (f c) (ite q (g (f c) d) (f c))))
(assert (not (= (f c) (g (f c) (f c)))))
(assert (or (= r (not (= c a)))))
(assert (= (ite r (f c) (f c)) (g (g (f c) d) (ite p (f c) (f c)))))
(assert (= b c))
(check-sat)
